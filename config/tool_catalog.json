[
  {
    "name": "tavily_search",
    "description": "Optimized web search for AI agents. Use for general knowledge, news, and researching topics.",
    "schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Max 400 chars. Keep concise."
        },
        "topic": {
          "type": "string",
          "enum": ["general", "news"],
          "default": "general",
          "description": "Use 'news' for recent events."
        },
        "search_depth": {
          "type": "string",
          "enum": ["basic", "advanced"],
          "default": "basic",
          "description": "'advanced' uses 2 credits for deeper crawl."
        },
        "max_results": { "type": "integer", "default": 5, "maximum": 20 },
        "include_domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains to strictly include."
        },
        "exclude_domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains to strictly exclude."
        },
        "include_raw_content": {
          "type": "boolean",
          "default": false,
          "description": "Fetch full page content (expensive)."
        },
        "time_range": {
          "type": "string",
          "enum": ["day", "week", "month", "year"],
          "description": "Filter by time."
        },
        "auto_parameters": {
          "type": "boolean",
          "default": false,
          "description": "Let Tavily optimize parameters automatically."
        }
      },
      "required": ["query"]
    },
    "implementationPath": "../tools/tavily/search"
  },
  {
    "name": "tavily_crawl",
    "description": "Graph-based website traversal for deep exploration of a domain.",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The seed URL to start crawling."
        },
        "max_depth": { "type": "integer", "default": 1 },
        "limit": { "type": "integer", "default": 10 }
      },
      "required": ["url"]
    },
    "implementationPath": "../tools/tavily/crawl"
  },
  {
    "name": "perplexity_search",
    "description": "Live web search with citation support. Best for fact-checking and deep research.",
    "schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "max_results": { "type": "integer", "default": 5 },
        "return_images": { "type": "boolean", "default": false },
        "return_snippets": { "type": "boolean", "default": true },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 code (e.g., 'US', 'GB') for location bias."
        }
      },
      "required": ["query"]
    },
    "implementationPath": "../tools/perplexity/search"
  },
  {
    "name": "anthropic_computer_use",
    "description": "Control a computer GUI (screen viewing, mouse, keyboard).",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "key",
            "type",
            "mouse_move",
            "left_click",
            "left_click_drag",
            "right_click",
            "middle_click",
            "double_click",
            "screenshot",
            "cursor_position"
          ]
        },
        "coordinate": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "[x, y] coordinates."
        },
        "text": {
          "type": "string",
          "description": "Text to type or key combo."
        }
      },
      "required": ["action"]
    },
    "implementationPath": "../tools/anthropic/computerUse"
  },
  {
    "name": "anthropic_bash",
    "description": "Execute bash commands in a sandboxed environment.",
    "schema": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "description": "The command to run." }
      },
      "required": ["command"]
    },
    "implementationPath": "../tools/anthropic/bash"
  },
  {
    "name": "anthropic_text_editor",
    "description": "View and edit files in the sandbox.",
    "schema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "enum": ["view", "create", "str_replace", "insert", "undo_edit"]
        },
        "path": { "type": "string", "description": "File path." },
        "file_text": {
          "type": "string",
          "description": "Content for create/insert."
        },
        "old_str": { "type": "string", "description": "String to replace." },
        "new_str": { "type": "string", "description": "Replacement string." }
      },
      "required": ["command", "path"]
    },
    "implementationPath": "../tools/anthropic/textEditor"
  },
  {
