  {
    "name": "cortex_add_to_catalog",
    "description": "Add a new model or tool to the cortex-core catalog. Validates the entry and updates the appropriate catalog file.",
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["model", "tool"],
          "description": "Whether to add a model or tool"
        },
        "data": {
          "type": "object",
          "description": "The model or tool definition as a JSON object. For models, must include: code, provider, modality_in, modality_out, context_tokens, capabilities. For tools, must include: name, description, schema, implementationPath."
        },
        "model_id": {
          "type": "string",
          "description": "Model ID (optional, will use data.code if not provided)"
        }
      },
      "required": ["type", "data"]
    },
    "implementationPath": "../tools/cortex/addToCatalog"
  }
